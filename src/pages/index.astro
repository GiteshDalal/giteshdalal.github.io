---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPublishedPosts, getProjects } from '../lib/content';

const published = await getPublishedPosts();
const featured = published[0];
const morePosts = published.slice(1, 5);
const projects = await getProjects();
---
<BaseLayout
  title="Home"
  description="Solution architecture, AI-assisted software delivery, and open-source tools that keep humans and agents aligned."
  image="/og/home.png"
>
  <div class="stack-lg">
    <section class="hero">
      <h1 class="hero-title">Solution architecture for AI-assisted delivery.</h1>
      <p class="hero-tagline">
        I write about durable software and build open-source tools that keep humans and agents aligned.
      </p>
      <div class="lede">
        <p>
          Hi, I’m Gitesh. I design software systems and document what holds up as AI agents
          reshape engineering practice—from delivery workflows to the context they need to do
          reliable work.
        </p>
      </div>
      <p class="hero-ctas">
        <a href="/blog/">Read the blog</a>
        <span class="hero-ctas-sep" aria-hidden="true">·</span>
        <a href="/projects/fdf/">Explore FDF</a>
        <span class="hero-ctas-sep" aria-hidden="true">·</span>
        <a href="https://www.linkedin.com/in/giteshdalal" rel="me">Connect on LinkedIn</a>
      </p>
      <div class="current-work">
        <h2>Current work</h2>
        <ul>
          <li><strong>FDF</strong><span>A validated documentation format for agentic projects.</span></li>
          <li><strong>Low-cost commerce rewrite</strong><span>Moving a Go platform to Rust toward near-zero running costs.</span></li>
          <li><strong>Multi-agent workflows</strong><span>Exploring durable collaboration across software and creative work.</span></li>
        </ul>
      </div>
    </section>

    <section>
      <h2 class="section-title">Latest writing</h2>
      <p class="section-intro">On AI, engineering, and the tools that survive the hype.</p>
      {featured ? (
        <FeaturedPost post={featured} />
      ) : (
        <p class="meta">No posts yet.</p>
      )}
      {morePosts.length > 0 && (
        <>
          <h3 class="subsection-title">More posts</h3>
          <PostList posts={morePosts} />
        </>
      )}
      <p class="section-footer-link">
        <a href="/blog/">All posts →</a>
      </p>
    </section>

    <section>
      <h2 class="section-title">Open source</h2>
      <p class="section-intro">Things I maintain and still use myself.</p>
      <div class="project-list">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      {projects.length > 0 && (
        <p class="section-footer-link">
          <a href="/projects/">All projects →</a>
        </p>
      )}
    </section>
  </div>
</BaseLayout>
