---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h3' } = Astro.props;
const href = `/projects/${project.id}/`;
const Heading = headingLevel;
---
<article class="project-card">
  <p class="project-card-eyebrow">Open source</p>
  <Heading class="project-card-title">
    <a href={href}>{project.data.title}</a>
  </Heading>
  <p class="project-card-tagline">{project.data.tagline}</p>
  <p class="project-card-actions">
    <a href={href}>View project →</a>
    <a href={project.data.github} rel="noopener noreferrer">GitHub →</a>
  </p>
</article>
